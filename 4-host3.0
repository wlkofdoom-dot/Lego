#sudo chown -R 1000:1000 /wlkofdoom/appdata/seerr
#sudo reboot


services:

  plex:
    image: lscr.io/linuxserver/plex
    container_name: plex
    networks:
      macvlan-net-a:
        ipv4_address: 192.168.1.200
      macvlan-net-b:
        ipv4_address: 10.0.0.200
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=America/New_York
      - VERSION=public
    volumes:
      - /wlkofdoom/appdata/plex/config:/config
      - /mnt/doomed/downloads:/downloads
      - /mnt/doomed:/doomed
      - /mnt/doomed/tv:/tv
      - /mnt/doomed/film:/movies
      - /mnt/doomed/np:/np
      - /mnt/doomed/music:/music
      - /mnt/doomed/franchises:/franchises
      - /mnt/doomed/books:/books
      - /mnt/doomed/standup:/standup
      - /mnt/doomed/backup/backups/arrr:/backup
    devices:
      - /dev/dri:/dev/dri
    restart: unless-stopped

  seerr:
    image: ghcr.io/seerr-team/seerr
    init: true
    container_name: seerr
    networks:
      macvlan-net-a:
        ipv4_address: 192.168.1.201
      macvlan-net-b:
        ipv4_address: 10.0.0.201
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=America/New_York
    ports:
      - 5001:5001
    volumes:
      - /wlkofdoom/appdata/seerr/config:/app/config
      - /mnt/doomed/downloads:/downloads
      - /mnt/doomed:/doomed
      - /mnt/doomed/tv:/tv
      - /mnt/doomed/film:/movies
      - /mnt/doomed/music:/music
      - /mnt/doomed/franchises:/franchises
      - /mnt/doomed/standup:/standup
      - /mnt/doomed/backup/backups/arrr:/backup
    healthcheck:
      test: wget --no-verbose --tries=1 --spider http://localhost:5055/api/v1/settings/public || exit 1
      start_period: 30s
      timeout: 3s
      interval: 15s
      retries: 3
    restart: unless-stopped

  plex-tv:
    image: lscr.io/linuxserver/plex
    container_name: plex-TV
    networks:
      macvlan-net-a:
        ipv4_address: 192.168.1.202
      macvlan-net-b:
        ipv4_address: 10.0.0.202
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=America/New_York
      - VERSION=public
    volumes:
      - /wlkofdoom/appdata/plex-Tv/config:/config
      - /mnt/doomed/downloads:/downloads
      - /mnt/doomed:/doomed
      - /mnt/doomed/tv:/tv
      - /mnt/doomed/film:/movies
      - /mnt/doomed/backup/backups/arrr:/backup
    devices:
      - /dev/dri:/dev/dri
    restart: unless-stopped

networks:
  macvlan-net-a:
    external: true
  macvlan-net-b:
    external: true
