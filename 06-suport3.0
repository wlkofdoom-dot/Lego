services:

  jackett:
    image: lscr.io/linuxserver/jackett
    container_name: jackett
    networks:
      macvlan-net-a:
        ipv4_address: 192.168.1.220
      macvlan-net-b:
        ipv4_address: 10.0.0.220
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=America/New_York
    volumes:
      - /wlkofdoom/appdata/jackett/config:/config
      - /mnt/doomed/downloads:/downloads
      - /mnt/doomed:/doomed
      - /mnt/doomed/tv/new:/tv
      - /mnt/doomed/film/new:/movies
      - /mnt/doomed/backup/backups/arrr:/backup
    ports:
      - 9117:9117
    restart: unless-stopped

  prowlarr:
    image: lscr.io/linuxserver/prowlarr
    container_name: prowlarr
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=America/New_York
    networks:
      macvlan-net-a:
        ipv4_address: 192.168.1.221
      macvlan-net-b:
        ipv4_address: 10.0.0.221
    volumes:
      - /mnt/doomed/music/new:/music
      - /wlkofdoom/appdata/prowlarr/config:/config
      - /mnt/doomed/downloads:/downloads
      - /mnt/doomed:/doomed
      - /mnt/doomed/tv/new:/tv
      - /mnt/doomed/film/new:/movies
      - /mnt/doomed/backup/backups/arrr:/backup
    ports:
      - 9696:9696
    restart: unless-stopped

  byparr:
    image: ghcr.io/thephaseless/byparr:latest
    container_name: byparr
    restart: unless-stopped
    init: true
    environment:
      - LOG_LEVEL=INFO
    ports:
      - 8191:8191
    networks:
      macvlan-net-a:
        ipv4_address: 192.168.1.222
      macvlan-net-b:
        ipv4_address: 10.0.0.222

  nzbhydra2:
    image: lscr.io/linuxserver/nzbhydra2:latest
    container_name: nzbhydra2
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=America/New_York
      - EXTRA_JVM_ARGUMENTS=-Xms512m -Xmx2g
    networks:
      macvlan-net-a:
        ipv4_address: 192.168.1.223
      macvlan-net-b:
        ipv4_address: 10.0.0.223
    volumes:
      - /wlkofdoom/appdata/nzbhydra2/configV2:/config
      - /mnt/doomed/downloads:/downloads
      - /mnt/doomed:/doomed
      - /mnt/doomed/tv/new:/tv
      - /mnt/doomed/film/new:/movies
      - /mnt/doomed/music/new:/music
      - /mnt/doomed/backup/backups/arrr:/backup
    ports:
      - 5076:5076
    restart: unless-stopped

  flaresolverr:
    image: ghcr.io/flaresolverr/flaresolverr
    container_name: flaresolverr
    environment:
      - LOG_LEVEL=info
      - LOG_HTML=false
      - CAPTCHA_SOLVER=none
      - TZ=America/New_York
    ports:
      - 8191:8191
    networks:
      macvlan-net-a:
        ipv4_address: 192.168.1.224
      macvlan-net-b:
        ipv4_address: 10.0.0.224
    restart: unless-stopped      

networks:
  macvlan-net-a:
    external: true
  macvlan-net-b:
    external: true
