services:

  radarr:
    image: lscr.io/linuxserver/radarr
    container_name: radar
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=America/New_York
    networks:
      macvlan-net-a:
        ipv4_address: 192.168.1.210
      macvlan-net-b:
        ipv4_address: 10.0.0.210
    volumes:
      - /wlkofdoom/appdata/radar/config:/config
      - /mnt/doomed/downloads:/downloads
      - /mnt/doomed/downloads/out:/out
      - /mnt/doomed:/doomed
      - /mnt/doomed/tv/new:/tv
      - /mnt/doomed/film/new:/movies
      - /mnt/doomed/franchises:/franchises
      - /mnt/doomed/standup:/standup
      - /mnt/doomed/backup/backups/arrr:/backup
    ports:
      - 7878:7878
    restart: unless-stopped

  sonarr:
    image: lscr.io/linuxserver/sonarr
    container_name: sonar  
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=America/New_York
    networks:
      macvlan-net-a:
        ipv4_address: 192.168.1.211
      macvlan-net-b:
        ipv4_address: 10.0.0.211
    volumes:
      - /wlkofdoom/appdata/sonar/config:/config
      - /mnt/doomed/downloads:/downloads
      - /mnt/doomed/downloads/out:/out
      - /mnt/doomed:/doomed
      - /mnt/doomed/tv/new:/tv
      - /mnt/doomed/film/new:/movies
      - /mnt/doomed/franchises:/franchises
      - /mnt/doomed/standup:/standup
      - /mnt/doomed/backup/backups/arrr:/backup
    ports:
      - 8989:8989
    restart: unless-stopped

  lidarr:
    image: lscr.io/linuxserver/lidarr
    container_name: lidarr
    networks:
      macvlan-net-a:
        ipv4_address: 192.168.1.212
      macvlan-net-b:
        ipv4_address: 10.0.0.212
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=America/New_York
    volumes:
      - /wlkofdoom/appdata/lidarr/config:/config
      - /mnt/doomed/downloads:/downloads
      - /mnt/doomed/downloads/out:/out
      - /mnt/doomed:/doomed
      - /mnt/doomed/music:/music
      - /mnt/doomed/books:/books
      - /mnt/doomed/standup:/standup
      - /mnt/doomed/backup/backups/arrr:/backup
    ports:
      - 8686:8686
    restart: unless-stopped

  pinchflat:
    image: ghcr.io/kieraneglin/pinchflat:latest
    container_name: pinchflat
    environment:
      - TZ=America/New_York
    networks:
      macvlan-net-a:
        ipv4_address: 192.168.1.213
      macvlan-net-b:
        ipv4_address: 10.0.0.213
    volumes:
      - /wlkofdoom/appdata/pinchflat/config:/config
      - /mnt/doomed/downloads:/downloads
      - /mnt/doomed:/doomed
      - /mnt/doomed/music:/music
      - /mnt/doomed/books:/books
      - /mnt/doomed/standup:/standup
      - /mnt/doomed/backup/backups/arrr:/backup
    ports:
      - 8945:8945
    restart: unless-stopped

networks:
  macvlan-net-a:
    external: true
  macvlan-net-b:
    external: true
