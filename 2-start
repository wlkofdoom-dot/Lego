      - /wlkofdoom/appdata/inception/data:/data
      - /mnt/doomed/downloads:/downloads
      - /mnt/doomed:/doomed
      - /mnt/doomed/backup/backups/arrr:/backup
      - /var/run/docker.sock:/var/run/docker.sock
      - /var/localtime:/etc/localtime:ro
    networks:
      macvlan-net-a:
        ipv4_address: 192.168.1.239
      macvlan-net-b:
        ipv4_address: 10.0.0.239

networks:
  macvlan-net-a:
    external: true
